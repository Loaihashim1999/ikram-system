APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id
HASH_VERIFY=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production Azure Blob settings use the User Assigned Managed Identity.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=
AZURE_CLIENT_ID=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Communication providers: fake (safe default) or taqnyat.
COMMUNICATION_PROVIDER=taqnyat
TAQNYAT_API_BASE_URL=https://api.taqnyat.sa/
TAQNYAT_CONNECT_TIMEOUT=5
TAQNYAT_TIMEOUT=10
TAQNYAT_SMS_TOKEN=
TAQNYAT_SMS_SENDER=EKRAM-SA
# SMS delivery webhook. Disabled until the account-specific callback contract is verified.
# The acknowledgement phrase is not an authentication secret.
TAQNYAT_SMS_WEBHOOK_ENABLED=false
TAQNYAT_SMS_WEBHOOK_ACK=EKRAM_WEBHOOK_RECEIVED
TAQNYAT_EMAIL_TOKEN=
TAQNYAT_EMAIL_FROM=
TAQNYAT_EMAIL_CAMPAIGN="IKRAM account recovery"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional one-time production administrator bootstrap. Existing admins are never changed.
IKRAM_ADMIN_USERNAME=admin
IKRAM_ADMIN_PASSWORD=
IKRAM_ADMIN_EMAIL=
IKRAM_ADMIN_FULL_NAME="مدير النظام"
