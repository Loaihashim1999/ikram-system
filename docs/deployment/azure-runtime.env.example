# Review-only NON-SECRET settings for a future revision; not loaded automatically.
# Preserve the existing Key Vault references; do not copy their values here.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://systemben.ekramfb.org.sa
DB_CONNECTION=pgsql
DB_SSLMODE=verify-full
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=azure
PUBLIC_FILESYSTEM_DRIVER=azure-storage-blob
PUBLIC_FILESYSTEM_VISIBILITY=private
SESSION_SECURE_COOKIE=true
LOG_CHANNEL=stderr
# Fill only independently verified ingress proxy IPs/CIDRs. Never use *.
# Keep empty until the ingress source addresses are confirmed by the operator.
TRUSTED_PROXIES=
